# Maximum concurrent workers (1–16); default 3
ORCHESTRATOR_MAX_WORKERS=3
# Verified OpenCode catalog ID; alternatively set per-task `model`.
ORCHESTRATOR_OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
# Verified by `agy models` (CLI 1.2.14).
ORCHESTRATOR_AGY_MODEL=gemini-3.8-flash-high
# Optional read-only dashboard port (binds 127.0.0.1); default 4317.
ORCHESTRATOR_DASHBOARD_PORT=4317
